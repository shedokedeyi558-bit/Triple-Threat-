# API Configuration
NEXT_PUBLIC_API_URL=https://bitlyfe-iiek.onrender.com

# App URL — must match FRONTEND_URL on the backend (Render env var).
# The backend uses this for Squad's callback URL: {FRONTEND_URL}/payment/verify
# If FRONTEND_URL is not set on Render, the backend falls back to https://bitlyf.vercel.app/payment/verify
# Update this when switching domains (Vercel, Netlify, custom domain, etc.)
NEXT_PUBLIC_APP_URL=https://bitlyf.vercel.app

# Set to true to re-enable Blitz on player-facing pages
NEXT_PUBLIC_BLITZ_ENABLED=false
